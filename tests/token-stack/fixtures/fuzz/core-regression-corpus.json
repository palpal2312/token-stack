    "scenario": "Rejects synthetic secret token in prompt and prevents disk write",
    "input": {
      "prompt": "Here is token=synthetic-canary-secret-do-not-persist",
      "response": "Should be filtered"
    },
    "expected": {
      "stored": false
    }
  },
